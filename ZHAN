<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>ZAHN - POS & Billing</title>
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.3.1/umd/react.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.3.1/umd/react-dom.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.24.7/babel.min.js"></script>
    <style>
        :root { box-sizing: border-box; padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
        body { background-color: #070d14; color: #dfbf75; font-family: 'Segoe UI', system-ui, sans-serif; margin: 0; }
        .bg-card { background-color: #0b1420; }
        .text-gold { color: #c59f51; }
        .border-gold { border-color: #c59f51; }
        .bg-gold { background-color: #c59f51; color: #070d14; }
        .bg-gold:hover { background-color: #dfbf75; }
        .field { background-color: #070d14; border: 1px solid #c59f51; color: #fff; padding: 8px; border-radius: 4px; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #070d14; }
        ::-webkit-scrollbar-thumb { background: #c59f51; border-radius: 4px; }
        .table-wrap { overflow-x: auto; }
        @media print {
            body { background-color: white; color: black; }
            .no-print { display: none !important; }
            .print-only { display: block !important; }
        }
        .print-only { display: none; }
    </style>
</head>
<body>
    <div id="root"></div>
    <script type="text/babel">
        const { useState, useEffect } = React;

        const LOGO_SRC = 'data:image/jpeg;base64,';
        const ML_SIZES = [10, 20, 30, 50, 80, 100];
        const EXPENSE_CATEGORIES = ['Rent', 'Salaries', 'Utilities', 'Transport', 'Marketing', 'Maintenance', 'Other'];

        const loadData = (key, fallback) => {
            try { const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : fallback; }
            catch (e) { return fallback; }
        };
        const saveData = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) {} };

        const dayKey = (d) => new Date(d).toLocaleDateString('en-CA');
        const monthKey = (d) => dayKey(d).slice(0, 7);
        const todayKey = () => dayKey(new Date());
        const firstOfMonthKey = () => todayKey().slice(0, 8) + '01';
        const r2 = (n) => Math.round((n || 0) * 100) / 100;
        const fmt = (n) => 'SAR ' + r2(n).toFixed(2);
        const pct = (n) => (n || 0).toFixed(1) + '%';
        const mlLabel = (ml) => ml ? `${ml} ML` : '';
        const itemLabel = (name, ml) => ml ? `${name} ${ml} ML` : name;

        const encodeInvoice = (sale) => btoa(unescape(encodeURIComponent(JSON.stringify(sale))));
        const decodeInvoice = (s) => { try { return JSON.parse(decodeURIComponent(escape(atob(s)))); } catch (e) { return null; } };
        const invoiceLink = (sale) => `${location.origin}${location.pathname}#inv=${encodeInvoice(sale)}`;

        // Sales + returns summary. Returns reduce revenue and profit.
        const summarize = (sales, returns = []) => {
            const revenue = sales.reduce((s, x) => s + x.totalAmount, 0);
            const cost = sales.reduce((s, x) => s + x.items.reduce((a, i) => a + (i.cost || 0) * i.qty, 0), 0);
            const units = sales.reduce((s, x) => s + x.items.reduce((a, i) => a + i.qty, 0), 0);
            const retRev = returns.reduce((s, r) => s + r.refund, 0);
            const retCost = returns.reduce((s, r) => s + r.cost, 0);
            const retUnits = returns.reduce((s, r) => s + r.qty, 0);
            const netSales = revenue - retRev;
            const profit = (revenue - cost) - (retRev - retCost);
            return { count: sales.length, revenue, cost, units, retRev, retCost, retUnits, netSales, profit, margin: netSales ? profit / netSales * 100 : 0 };
        };

        const aggregateByProduct = (sales, returns = []) => {
            const map = {};
            const get = (name, ml) => { const k = name + '|' + ml; return map[k] || (map[k] = { name, ml, qty: 0, revenue: 0, cost: 0 }); };
            sales.forEach(s => s.items.forEach(i => { const p = get(i.name, i.ml); p.qty += i.qty; p.revenue += i.price * i.qty; p.cost += (i.cost || 0) * i.qty; }));
            returns.forEach(r => { const p = get(r.name, r.ml); p.qty -= r.qty; p.revenue -= r.refund; p.cost -= r.cost; });
            return Object.values(map)
                .map(p => ({ ...p, profit: p.revenue - p.cost, margin: p.revenue ? (p.revenue - p.cost) / p.revenue * 100 : 0 }))
                .sort((a, b) => b.profit - a.profit);
        };

        const groupBy = (sales, returns, keyFn) => {
            const map = {};
            const slot = (k) => map[k] || (map[k] = { s: [], r: [] });
            sales.forEach(s => slot(keyFn(s.date)).s.push(s));
            returns.forEach(r => slot(keyFn(r.date)).r.push(r));
            return Object.keys(map).sort().map(k => ({ key: k, ...summarize(map[k].s, map[k].r) }));
        };

        const downloadCSV = (filename, rows) => {
            const csv = rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n');
            const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = filename; a.click();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
        };

        const Card = ({ label, value, color = 'text-white' }) => (
            <div className="bg-card border border-gold p-4 rounded text-center">
                <p className="opacity-80 mb-2 text-sm">{label}</p>
                <h4 className={`text-xl font-bold ${color}`}>{value}</h4>
            </div>
        );

        const Table = ({ headers, rows, footer }) => (
            <div className="table-wrap">
                <table className="w-full text-left text-sm">
                    <thead>
                        <tr className="border-b border-gold">
                            {headers.map((h, i) => <th key={i} className={`py-2 pr-3 ${i > 0 ? 'text-right' : ''}`}>{h}</th>)}
                        </tr>
                    </thead>
                    <tbody>
                        {rows.length === 0 && <tr><td colSpan={headers.length} className="py-4 text-center opacity-60">No records for this period.</td></tr>}
                        {rows.map((r, i) => (
                            <tr key={i} className="border-b border-gray-800">
                                {r.map((c, j) => <td key={j} className={`py-2 pr-3 ${j > 0 ? 'text-right' : ''}`}>{c}</td>)}
                            </tr>
                        ))}
                    </tbody>
                    {footer && <tfoot><tr className="border-t-2 border-gold font-bold">{footer.map((c, j) => <td key={j} className={`py-2 pr-3 ${j > 0 ? 'text-right' : ''}`}>{c}</td>)}</tr></tfoot>}
                </table>
            </div>
        );

        const DateInput = ({ value, onChange, type = 'date' }) => (
            <input type={type} className="field" value={value} onChange={e => onChange(e.target.value)} />
        );

        const DailyReport = ({ sales, returns, expenses }) => {
            const [date, setDate] = useState(todayKey());
            const list = sales.filter(s => dayKey(s.date) === date).slice().reverse();
            const rets = returns.filter(r => dayKey(r.date) === date);
            const t = summarize(list, rets);
            const expList = expenses.filter(e => e.date === date);
            const exp = expList.reduce((s, e) => s + e.amount, 0);
            const cash = list.filter(s => (s.payment || 'Cash') === 'Cash').reduce((a, s) => a + s.totalAmount, 0);
            const card = list.filter(s => s.payment === 'Card').reduce((a, s) => a + s.totalAmount, 0);
            return (
                <div>
                    <div className="flex flex-wrap gap-3 items-center justify-between mb-6">
                        <div className="flex items-center gap-3"><label className="text-sm opacity-80">Date</label><DateInput value={date} onChange={setDate} /></div>
                        <button onClick={() => downloadCSV(`ZAHN_Daily_${date}.csv`, [
                            ['Time', 'Invoice', 'Customer', 'Payment', 'Items', 'Amount', 'Profit'],
                            ...list.map(s => [new Date(s.date).toLocaleTimeString(), s.id, s.customerName, s.payment || 'Cash', s.items.map(i => `${itemLabel(i.name, i.ml)} x${i.qty}`).join('; '), s.totalAmount, s.profit])
                        ])} className="bg-green-600 text-white px-4 py-2 rounded font-bold hover:bg-green-700">Export CSV</button>
                    </div>
                    <div className="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
                        <Card label="Invoices" value={t.count} />
                        <Card label="Units Sold" value={t.units} />
                        <Card label="Gross Sales" value={fmt(t.revenue)} />
                        <Card label="Returns" value={fmt(t.retRev)} color="text-red-400" />
                        <Card label="Net Sales" value={fmt(t.netSales)} />
                        <Card label="Gross Profit" value={fmt(t.profit)} color="text-green-400" />
                        <Card label="Expenses" value={fmt(exp)} color="text-red-400" />
                        <Card label="Net Profit" value={fmt(t.profit - exp)} color="text-green-400" />
                        <Card label="Cash / Card" value={`${fmt(cash)} / ${fmt(card)}`} />
                    </div>
                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">Sales</h4>
                            <Table headers={['Time / Customer', 'Items', 'Amount', 'Profit']}
                                rows={list.map(s => [
                                    <span>{new Date(s.date).toLocaleTimeString()}<br/><span className="opacity-70">{s.customerName} · {s.payment || 'Cash'}</span></span>,
                                    s.items.map(i => `${itemLabel(i.name, i.ml)} x${i.qty}`).join(', '),
                                    fmt(s.totalAmount),
                                    <span className="text-green-400">{fmt(s.profit)}</span>])}
                                footer={['Total', '', fmt(t.revenue), fmt(t.profit)]} />
                        </div>
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">Returns</h4>
                            <Table headers={['Item', 'Qty', 'Refund']}
                                rows={rets.map(r => [itemLabel(r.name, r.ml), r.qty, <span className="text-red-400">{fmt(r.refund)}</span>])}
                                footer={['Total', t.retUnits, fmt(t.retRev)]} />
                        </div>
                        <div className="bg-card border border-gold p-5 rounded lg:col-span-2">
                            <h4 className="font-bold text-lg mb-3 text-gold">Expenses</h4>
                            <Table headers={['Category', 'Description', 'Amount']}
                                rows={expList.map(e => [e.category, e.description || '-', <span className="text-red-400">{fmt(e.amount)}</span>])}
                                footer={['Total', '', fmt(exp)]} />
                        </div>
                    </div>
                </div>
            );
        };

        const MonthEndReport = ({ sales, returns, purchases, products, expenses }) => {
            const [month, setMonth] = useState(monthKey(new Date()));
            const mSales = sales.filter(s => monthKey(s.date) === month);
            const mRets = returns.filter(r => monthKey(r.date) === month);
            const mPurch = purchases.filter(p => monthKey(p.date) === month);
            const t = summarize(mSales, mRets);
            const purchaseTotal = mPurch.reduce((s, p) => s + p.totalCost, 0);
            const expList = expenses.filter(e => e.date.slice(0, 7) === month);
            const exp = expList.reduce((s, e) => s + e.amount, 0);
            const expCats = EXPENSE_CATEGORIES.map(c => ({ name: c, amount: expList.filter(e => e.category === c).reduce((s, e) => s + e.amount, 0) })).filter(c => c.amount > 0);
            const stockValue = products.reduce((s, p) => s + p.stock * (p.cost || 0), 0);
            const stockUnits = products.reduce((s, p) => s + p.stock, 0);
            const daily = groupBy(mSales, mRets, d => dayKey(d));
            const top = aggregateByProduct(mSales, mRets).slice(0, 10);
            return (
                <div>
                    <div className="flex flex-wrap gap-3 items-center justify-between mb-6">
                        <div className="flex items-center gap-3"><label className="text-sm opacity-80">Month</label><DateInput value={month} onChange={setMonth} type="month" /></div>
                        <button onClick={() => downloadCSV(`ZAHN_MonthEnd_${month}.csv`, [
                            ['Metric', 'Value (SAR)'],
                            ['Gross sales', t.revenue], ['Returns', t.retRev], ['Net sales', t.netSales], ['Cost of goods (net)', t.cost - t.retCost],
                            ['Gross profit', t.profit], ['Expenses', exp], ['Net profit', t.profit - exp],
                            ['Purchases in month', purchaseTotal], ['Closing stock value (current)', stockValue],
                            [], ['Date', 'Invoices', 'Gross sales', 'Returns', 'Profit'],
                            ...daily.map(d => [d.key, d.count, d.revenue, d.retRev, d.profit])
                        ])} className="bg-green-600 text-white px-4 py-2 rounded font-bold hover:bg-green-700">Export CSV</button>
                    </div>
                    <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                        <Card label="Gross Sales" value={fmt(t.revenue)} />
                        <Card label="Returns" value={fmt(t.retRev)} color="text-red-400" />
                        <Card label="Net Sales" value={fmt(t.netSales)} />
                        <Card label="Gross Profit" value={fmt(t.profit)} color="text-green-400" />
                        <Card label="Expenses" value={fmt(exp)} color="text-red-400" />
                        <Card label="Net Profit" value={fmt(t.profit - exp)} color="text-green-400" />
                        <Card label="Margin" value={pct(t.margin)} color="text-gold" />
                        <Card label="Purchases" value={fmt(purchaseTotal)} />
                        <Card label="Invoices" value={t.count} />
                        <Card label="Units Sold (net)" value={t.units - t.retUnits} />
                        <Card label="Stock Value (Now)" value={`${fmt(stockValue)} · ${stockUnits} pcs`} color="text-gold" />
                    </div>
                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">Daily Breakdown</h4>
                            <Table headers={['Date', 'Invoices', 'Net Sales', 'Profit']}
                                rows={daily.map(d => [d.key, d.count, fmt(d.netSales), <span className="text-green-400">{fmt(d.profit)}</span>])}
                                footer={['Total', t.count, fmt(t.netSales), fmt(t.profit)]} />
                        </div>
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">Top Products</h4>
                            <Table headers={['Product', 'Qty', 'Revenue', 'Profit']}
                                rows={top.map(p => [itemLabel(p.name, p.ml), p.qty, fmt(p.revenue), <span className="text-green-400">{fmt(p.profit)}</span>])} />
                        </div>
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">Expenses by Category</h4>
                            <Table headers={['Category', 'Amount']}
                                rows={expCats.map(c => [c.name, <span className="text-red-400">{fmt(c.amount)}</span>])}
                                footer={['Total', fmt(exp)]} />
                        </div>
                    </div>
                </div>
            );
        };

        const ProfitReport = ({ sales, returns, expenses }) => {
            const [from, setFrom] = useState(firstOfMonthKey());
            const [to, setTo] = useState(todayKey());
            const inRange = (d) => dayKey(d) >= from && dayKey(d) <= to;
            const list = sales.filter(s => inRange(s.date));
            const rets = returns.filter(r => inRange(r.date));
            const t = summarize(list, rets);
            const exp = expenses.filter(e => e.date >= from && e.date <= to).reduce((s, e) => s + e.amount, 0);
            const byProduct = aggregateByProduct(list, rets);
            const byMonth = groupBy(sales, returns, d => monthKey(d));
            return (
                <div>
                    <div className="flex flex-wrap gap-3 items-center justify-between mb-6">
                        <div className="flex flex-wrap items-center gap-3">
                            <label className="text-sm opacity-80">From</label><DateInput value={from} onChange={setFrom} />
                            <label className="text-sm opacity-80">To</label><DateInput value={to} onChange={setTo} />
                        </div>
                        <button onClick={() => downloadCSV(`ZAHN_Profit_${from}_to_${to}.csv`, [
                            ['Product', 'Qty', 'Revenue', 'Cost', 'Profit', 'Margin %'],
                            ...byProduct.map(p => [itemLabel(p.name, p.ml), p.qty, p.revenue, p.cost, p.profit, p.margin.toFixed(1)]),
                            [], ['Month', 'Net sales', 'Gross profit', 'Margin %'],
                            ...byMonth.map(m => [m.key, m.netSales, m.profit, m.margin.toFixed(1)])
                        ])} className="bg-green-600 text-white px-4 py-2 rounded font-bold hover:bg-green-700">Export CSV</button>
                    </div>
                    <div className="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
                        <Card label="Net Sales" value={fmt(t.netSales)} />
                        <Card label="Gross Profit" value={fmt(t.profit)} color="text-green-400" />
                        <Card label="Expenses" value={fmt(exp)} color="text-red-400" />
                        <Card label="Net Profit" value={fmt(t.profit - exp)} color="text-green-400" />
                        <Card label="Margin" value={pct(t.margin)} color="text-gold" />
                    </div>
                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">Profit by Product</h4>
                            <Table headers={['Product', 'Qty', 'Profit', 'Margin']}
                                rows={byProduct.map(p => [itemLabel(p.name, p.ml), p.qty, <span className="text-green-400">{fmt(p.profit)}</span>, pct(p.margin)])} />
                        </div>
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">Profit by Month (all time)</h4>
                            <Table headers={['Month', 'Net Sales', 'Gross Profit', 'Margin']}
                                rows={byMonth.slice().reverse().map(m => [m.key, fmt(m.netSales), <span className="text-green-400">{fmt(m.profit)}</span>, pct(m.margin)])} />
                        </div>
                    </div>
                </div>
            );
        };

        const ReturnsReport = ({ returns }) => {
            const [from, setFrom] = useState(firstOfMonthKey());
            const [to, setTo] = useState(todayKey());
            const list = returns.filter(r => dayKey(r.date) >= from && dayKey(r.date) <= to).slice().reverse();
            const total = list.reduce((s, r) => s + r.refund, 0);
            const units = list.reduce((s, r) => s + r.qty, 0);
            const byItem = {};
            list.forEach(r => { const k = itemLabel(r.name, r.ml); byItem[k] = byItem[k] || { name: k, qty: 0, refund: 0 }; byItem[k].qty += r.qty; byItem[k].refund += r.refund; });
            return (
                <div>
                    <div className="flex flex-wrap gap-3 items-center justify-between mb-6">
                        <div className="flex flex-wrap items-center gap-3">
                            <label className="text-sm opacity-80">From</label><DateInput value={from} onChange={setFrom} />
                            <label className="text-sm opacity-80">To</label><DateInput value={to} onChange={setTo} />
                        </div>
                        <button onClick={() => downloadCSV(`ZAHN_Returns_${from}_to_${to}.csv`, [
                            ['Date', 'Item', 'Qty', 'Refund', 'Reason'],
                            ...list.map(r => [new Date(r.date).toLocaleString(), itemLabel(r.name, r.ml), r.qty, r.refund, r.reason || ''])
                        ])} className="bg-green-600 text-white px-4 py-2 rounded font-bold hover:bg-green-700">Export CSV</button>
                    </div>
                    <div className="grid grid-cols-2 gap-4 mb-6">
                        <Card label="Returned Units" value={units} />
                        <Card label="Total Refunded" value={fmt(total)} color="text-red-400" />
                    </div>
                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">By Item</h4>
                            <Table headers={['Item', 'Qty', 'Refund']}
                                rows={Object.values(byItem).map(i => [i.name, i.qty, fmt(i.refund)])} />
                        </div>
                        <div className="bg-card border border-gold p-5 rounded">
                            <h4 className="font-bold text-lg mb-3 text-gold">Return History</h4>
                            <Table headers={['Date / Item', 'Reason', 'Refund']}
                                rows={list.map(r => [<span>{new Date(r.date).toLocaleDateString()}<br/><span className="opacity-70">{itemLabel(r.name, r.ml)} x{r.qty}</span></span>, r.reason || '-', fmt(r.refund)])} />
                        </div>
                    </div>
                </div>
            );
        };

        const ReportsView = ({ sales, returns, purchases, products, expenses }) => {
            const [sub, setSub] = useState('daily');
            const subs = [['daily', 'Daily'], ['month', 'Month-End'], ['profit', 'Profit'], ['returns', 'Returns']];
            return (
                <div>
                    <div className="flex flex-wrap gap-2 mb-6">
                        {subs.map(([k, label]) => (
                            <button key={k} onClick={() => setSub(k)}
                                className={`px-4 py-2 rounded font-semibold ${sub === k ? 'bg-gold text-black' : 'border border-gold text-gold hover:bg-gold hover:text-black'}`}>
                                {label} Report
                            </button>
                        ))}
                    </div>
                    {sub === 'daily' && <DailyReport sales={sales} returns={returns} expenses={expenses} />}
                    {sub === 'month' && <MonthEndReport sales={sales} returns={returns} purchases={purchases} products={products} expenses={expenses} />}
                    {sub === 'profit' && <ProfitReport sales={sales} returns={returns} expenses={expenses} />}
                    {sub === 'returns' && <ReturnsReport returns={returns} />}
                </div>
            );
        };

        const ExpensesView = ({ expenses, setExpenses }) => {
            const [date, setDate] = useState(todayKey());
            const [category, setCategory] = useState(EXPENSE_CATEGORIES[0]);
            const [description, setDescription] = useState('');
            const [amount, setAmount] = useState('');
            const add = () => {
                const amt = parseFloat(amount);
                if (!amt || amt <= 0) { alert('Enter a valid amount.'); return; }
                setExpenses(prev => [...prev, { id: Date.now(), date, category, description, amount: amt }]);
                setDescription(''); setAmount('');
            };
            const remove = (id) => { if (confirm('Delete this expense?')) setExpenses(prev => prev.filter(e => e.id !== id)); };
            const list = expenses.slice().sort((a, b) => b.date.localeCompare(a.date));
            const total = expenses.reduce((s, e) => s + e.amount, 0);
            return (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div className="bg-card border border-gold p-6 rounded">
                        <h3 className="text-xl mb-4 font-bold text-gold border-b border-gold pb-2">Add Expense</h3>
                        <div className="space-y-4">
                            <input type="date" className="field w-full" value={date} onChange={e => setDate(e.target.value)} />
                            <select className="field w-full" value={category} onChange={e => setCategory(e.target.value)}>
                                {EXPENSE_CATEGORIES.map(c => <option key={c}>{c}</option>)}
                            </select>
                            <input type="text" placeholder="Description" className="field w-full" value={description} onChange={e => setDescription(e.target.value)} />
                            <input type="number" placeholder="Amount (SAR)" className="field w-full" value={amount} onChange={e => setAmount(e.target.value)} />
                            <button onClick={add} className="w-full bg-gold text-black font-bold py-2 rounded">SAVE EXPENSE</button>
                        </div>
                    </div>
                    <div className="bg-card border border-gold p-6 rounded">
                        <div className="flex justify-between items-center border-b border-gold pb-2 mb-4">
                            <h3 className="text-xl font-bold text-gold">Expense History</h3>
                            <span className="font-bold text-red-400">Total: {fmt(total)}</span>
                        </div>
                        <div className="overflow-auto h-[55vh]">
                            {list.length === 0 && <p className="opacity-60">No expenses recorded yet.</p>}
                            {list.map(e => (
                                <div key={e.id} className="border-b border-gray-700 py-2 flex justify-between items-center gap-3">
                                    <div>
                                        <p className="font-bold">{e.category}{e.description ? ' - ' + e.description : ''}</p>
                                        <p className="text-sm opacity-70">{e.date}</p>
                                    </div>
                                    <div className="flex items-center gap-3">
                                        <span className="text-red-400 font-bold">{fmt(e.amount)}</span>
                                        <button onClick={() => remove(e.id)} className="text-red-400 text-sm border border-red-400 px-2 rounded">x</button>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            );
        };

        const ReturnsView = ({ products, setProducts, returns, setReturns }) => {
            const [prodId, setProdId] = useState('');
            const [qty, setQty] = useState('');
            const [refund, setRefund] = useState('');
            const [reason, setReason] = useState('');
            const selected = products.find(p => p.id === prodId);
            const submit = () => {
                const q = parseInt(qty);
                if (!selected) { alert('Select an item.'); return; }
                if (!q || q <= 0) { alert('Enter a valid quantity.'); return; }
                const amount = r2(parseFloat(refund)) || r2(selected.price * q);
                setReturns(prev => [...prev, {
                    id: Date.now(), date: new Date().toISOString(), productId: selected.id,
                    name: selected.name, ml: selected.ml, qty: q, refund: amount,
                    cost: r2((selected.cost || 0) * q), reason
                }]);
                setProducts(prev => prev.map(p => p.id === selected.id ? { ...p, stock: p.stock + q } : p));
                setProdId(''); setQty(''); setRefund(''); setReason('');
            };
            return (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div className="bg-card border border-gold p-6 rounded">
                        <h3 className="text-xl mb-4 font-bold text-gold border-b border-gold pb-2">Sales Return</h3>
                        <div className="space-y-4">
                            <select className="field w-full" value={prodId} onChange={e => { setProdId(e.target.value); setRefund(''); }}>
                                <option value="">-- Select item --</option>
                                {products.map(p => <option key={p.id} value={p.id}>{itemLabel(p.name, p.ml)} (SAR {p.price})</option>)}
                            </select>
                            <input type="number" placeholder="Quantity returned" className="field w-full" value={qty} onChange={e => setQty(e.target.value)} />
                            <input type="number" placeholder={selected ? `Refund (default SAR ${r2(selected.price * (parseInt(qty) || 0))})` : 'Refund amount (SAR)'} className="field w-full" value={refund} onChange={e => setRefund(e.target.value)} />
                            <input type="text" placeholder="Reason (optional)" className="field w-full" value={reason} onChange={e => setReason(e.target.value)} />
                            <button onClick={submit} className="w-full bg-gold text-black font-bold py-2 rounded">SAVE RETURN & RESTOCK</button>
                        </div>
                    </div>
                    <div className="bg-card border border-gold p-6 rounded">
                        <h3 className="text-xl mb-4 font-bold text-gold border-b border-gold pb-2">Recent Returns</h3>
                        <div className="overflow-auto h-[55vh]">
                            {returns.length === 0 && <p className="opacity-60">No returns yet.</p>}
                            {returns.slice().reverse().map(r => (
                                <div key={r.id} className="border-b border-gray-700 py-2 flex justify-between">
                                    <div>
                                        <p className="font-bold">{itemLabel(r.name, r.ml)} x{r.qty}</p>
                                        <p className="text-sm opacity-70">{new Date(r.date).toLocaleString()}{r.reason ? ' · ' + r.reason : ''}</p>
                                    </div>
                                    <span className="text-red-400 font-bold">{fmt(r.refund)}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            );
        };

        const Logo = () => LOGO_SRC ? (
            <div className="flex flex-col items-center py-4"><img src={LOGO_SRC} alt="ZAHN" style={{maxHeight: 90}} /></div>
        ) : <LogoMark />;

        const LogoMark = () => (
            <div className="flex flex-col items-center justify-center py-4">
                <h1 className="text-3xl font-bold tracking-[0.2em] mt-2 text-[#c59f51]" style={{fontFamily: 'serif'}}>ZAHN</h1>
                <p className="text-xs tracking-[0.3em] text-[#dfbf75]">ESSENCE OF YOU</p>
            </div>
        );

        const InvoiceView = ({ sale }) => (
            <div className="min-h-screen p-6 flex justify-center">
                <div className="bg-white text-black w-full max-w-md p-6 rounded">
                    <Logo />
                    <div className="text-center mb-4">
                        <h2 className="text-xl font-bold">TAX INVOICE</h2>
                        <p className="text-sm">Date: {new Date(sale.date).toLocaleString()}</p>
                    </div>
                    <div className="mb-4 text-sm">
                        <p><strong>Customer:</strong> {sale.customerName}</p>
                        {sale.customerPhone && <p><strong>Phone:</strong> {sale.customerPhone}</p>}
                        <p><strong>Invoice No:</strong> #{sale.id}</p>
                        <p><strong>Payment:</strong> {sale.payment || 'Cash'}</p>
                    </div>
                    <table className="w-full text-left text-sm mb-4">
                        <thead>
                            <tr className="border-b-2 border-black"><th className="py-1">Item</th><th>Qty</th><th>Price</th><th className="text-right">Total</th></tr>
                        </thead>
                        <tbody>
                            {sale.items.map((i, idx) => (
                                <tr key={idx} className="border-b border-gray-300"><td className="py-1">{itemLabel(i.name, i.ml)}</td><td>{i.qty}</td><td>{i.price}</td><td className="text-right">{i.price * i.qty}</td></tr>
                            ))}
                        </tbody>
                    </table>
                    {sale.discount > 0 && <div className="flex justify-between text-sm"><span>Subtotal</span><span>SAR {sale.subtotal}</span></div>}
                    {sale.discount > 0 && <div className="flex justify-between text-sm"><span>Discount</span><span>- SAR {sale.discount}</span></div>}
                    <div className="flex justify-between font-bold text-xl border-t-2 border-black pt-2 mt-2"><span>Grand Total</span><span>SAR {sale.totalAmount}</span></div>
                    <p className="text-center text-sm mt-6">Thank you for shopping with ZAHN!</p>
                </div>
            </div>
        );

        const App = () => {
            const sharedSale = (() => { const m = location.hash.match(/inv=([^&]+)/); return m ? decodeInvoice(m[1]) : null; })();
            const [activeTab, setActiveTab] = useState('pos');
            const [products, setProducts] = useState(() => loadData('zahn_products', []));
            const [sales, setSales] = useState(() => loadData('zahn_sales', []));
            const [purchases, setPurchases] = useState(() => loadData('zahn_purchases', []));
            const [expenses, setExpenses] = useState(() => loadData('zahn_expenses', []));
            const [returns, setReturns] = useState(() => loadData('zahn_returns', []));

            const [cart, setCart] = useState([]);
            const [pickName, setPickName] = useState(null);
            const [customerName, setCustomerName] = useState('');
            const [customerPhone, setCustomerPhone] = useState('');
            const [payment, setPayment] = useState('Cash');
            const [discount, setDiscount] = useState('');
            const [discountType, setDiscountType] = useState('amount');
            const [billToPrint, setBillToPrint] = useState(null);
            const [waSale, setWaSale] = useState(null);

            const [pName, setPName] = useState('');
            const [pMl, setPMl] = useState('');
            const [pCost, setPCost] = useState('');
            const [pPrice, setPPrice] = useState('');
            const [pQty, setPQty] = useState('');
            const [bName, setBName] = useState('');
            const [bMl, setBMl] = useState('');
            const [bCost, setBCost] = useState('');
            const [bCounts, setBCounts] = useState({});
            const [bPrices, setBPrices] = useState({});
            const [editPurchase, setEditPurchase] = useState(null);

            const addBulk = () => {
                const name = bName.trim();
                const totalMl = parseFloat(bMl) || 0;
                const totalCost = parseFloat(bCost) || 0;
                if (!name) { alert('Enter product name.'); return; }
                if (totalMl <= 0 || totalCost <= 0) { alert('Enter total ML and total cost.'); return; }
                const lines = ML_SIZES.map(ml => ({ ml, count: parseInt(bCounts[ml]) || 0, price: parseFloat(bPrices[ml]) || 0 })).filter(x => x.count > 0);
                if (lines.length === 0) { alert('Enter bottle count for at least one size.'); return; }
                const usedMl = lines.reduce((s, x) => s + x.ml * x.count, 0);
                if (usedMl > totalMl) { alert(`Bottles need ${usedMl} ML but only ${totalMl} ML was bought.`); return; }
                const costPerMl = totalCost / totalMl;
                const now = new Date().toISOString();
                setProducts(prev => {
                    const arr = [...prev];
                    lines.forEach(({ ml, count, price }) => {
                        const unitCost = r2(costPerMl * ml);
                        const idx = arr.findIndex(p => p.name.toLowerCase() === name.toLowerCase() && p.ml === ml);
                        if (idx >= 0) arr[idx] = { ...arr[idx], stock: arr[idx].stock + count, cost: unitCost, price: price || arr[idx].price };
                        else arr.push({ id: (Date.now() + ml).toString(), name, ml, cost: unitCost, price, stock: count });
                    });
                    return arr;
                });
                setPurchases(prev => [...prev, ...lines.map(({ ml, count }) => ({
                    id: Date.now() + ml, date: now, productName: name, ml, qty: count, totalCost: r2(count * costPerMl * ml)
                }))]);
                setBName(''); setBMl(''); setBCost(''); setBCounts({}); setBPrices({});
            };

            const startEdit = (p) => setEditPurchase({ id: p.id, name: p.productName, ml: p.ml, qty: String(p.qty), unitCost: String(p.qty ? r2(p.totalCost / p.qty) : 0) });

            const saveEdit = () => {
                const p = purchases.find(x => x.id === editPurchase.id);
                if (!p) { setEditPurchase(null); return; }
                const newQty = parseInt(editPurchase.qty);
                const newCost = parseFloat(editPurchase.unitCost);
                if (!newQty || newQty <= 0 || isNaN(newCost) || newCost < 0) { alert('Enter a valid quantity and cost.'); return; }
                const diff = newQty - p.qty;
                const prod = products.find(x => x.name === p.productName && x.ml === p.ml);
                if (prod && prod.stock + diff < 0) { alert('Cannot reduce: some of these items are already sold.'); return; }
                setPurchases(prev => prev.map(x => x.id === p.id ? { ...x, qty: newQty, totalCost: r2(newQty * newCost) } : x));
                if (prod) setProducts(prev => prev.map(x => x.id === prod.id ? { ...x, stock: x.stock + diff, cost: newCost } : x));
                setEditPurchase(null);
            };

            const deletePurchase = () => {
                const p = purchases.find(x => x.id === editPurchase.id);
                if (!p) { setEditPurchase(null); return; }
                const prod = products.find(x => x.name === p.productName && x.ml === p.ml);
                if (prod && prod.stock - p.qty < 0) { alert('Cannot delete: some of these items are already sold.'); return; }
                if (!confirm('Delete this purchase and reduce stock?')) return;
                setPurchases(prev => prev.filter(x => x.id !== p.id));
                if (prod) setProducts(prev => prev.map(x => x.id === prod.id ? { ...x, stock: x.stock - p.qty } : x));
                setEditPurchase(null);
            };

            useEffect(() => { saveData('zahn_products', products); }, [products]);
            useEffect(() => { saveData('zahn_sales', sales); }, [sales]);
            useEffect(() => { saveData('zahn_purchases', purchases); }, [purchases]);
            useEffect(() => { saveData('zahn_expenses', expenses); }, [expenses]);
            useEffect(() => { saveData('zahn_returns', returns); }, [returns]);

            if (sharedSale) return <InvoiceView sale={sharedSale} />;

            const addToCart = (product) => {
                if (product.stock <= 0) { alert('Out of Stock!'); return; }
                const existing = cart.find(item => item.id === product.id);
                if (existing) {
                    if (existing.qty >= product.stock) return;
                    setCart(cart.map(item => item.id === product.id ? { ...item, qty: item.qty + 1 } : item));
                } else {
                    setCart([...cart, { id: product.id, name: product.name, ml: product.ml, price: product.price, cost: product.cost || 0, stock: product.stock, qty: 1 }]);
                }
            };
            const removeFromCart = (id) => setCart(cart.filter(item => item.id !== id));

            const subtotal = cart.reduce((s, i) => s + (i.price * i.qty), 0);
            const rawDiscount = parseFloat(discount) || 0;
            const discountValue = discountType === 'percent' ? subtotal * Math.min(rawDiscount, 100) / 100 : rawDiscount;
            const discountAmt = r2(Math.min(subtotal, Math.max(0, discountValue)));
            const cartTotal = r2(subtotal - discountAmt);

            const sendWhatsApp = (sale) => {
                let num = String(sale.customerPhone || '').replace(/\D/g, '');
                if (num.startsWith('00')) num = num.slice(2);
                else if (num.length === 10 && num.startsWith('05')) num = '966' + num.slice(1);
                else if (num.length === 9 && num.startsWith('5')) num = '966' + num;
                else if (num.length === 10) num = '91' + num;
                else if (num.length === 11 && num.startsWith('0')) num = '91' + num.slice(1);
                const lines = [
                    '*ZAHN - Essence of You*',
                    `Invoice #${sale.id}`,
                    `Date: ${new Date(sale.date).toLocaleString()}`,
                    '',
                    ...sale.items.map(i => `${itemLabel(i.name, i.ml)} x${i.qty} = SAR ${i.price * i.qty}`),
                    '',
                    ...(sale.discount > 0 ? [`Subtotal: SAR ${sale.subtotal}`, `Discount: - SAR ${sale.discount}`] : []),
                    `*Total: SAR ${sale.totalAmount}*`,
                    `Payment: ${sale.payment || 'Cash'}`,
                    `View invoice: ${invoiceLink(sale)}`,
                    '',
                    'Thank you for shopping with ZAHN!'
                ];
                return `https://wa.me/${num}?text=${encodeURIComponent(lines.join('\n'))}`;
            };

            const completeSale = () => {
                if (cart.length === 0) return;
                const sale = {
                    id: Date.now(),
                    date: new Date().toISOString(),
                    customerName: customerName || 'Walk-in Customer',
                    customerPhone,
                    items: cart.map(i => ({ id: i.id, name: i.name, ml: i.ml, price: i.price, cost: i.cost, qty: i.qty })),
                    subtotal,
                    discount: discountAmt,
                    payment,
                    totalAmount: cartTotal,
                    profit: r2(cartTotal - cart.reduce((s, i) => s + i.cost * i.qty, 0))
                };
                setSales(prev => [...prev, sale]);
                setProducts(prev => prev.map(p => {
                    const c = cart.find(x => x.id === p.id);
                    return c ? { ...p, stock: p.stock - c.qty } : p;
                }));
                setBillToPrint(sale);
                setWaSale(sale);
                setCart([]); setCustomerName(''); setCustomerPhone(''); setDiscount(''); setPayment('Cash');
                setTimeout(() => window.print(), 500);
            };

            const addPurchase = () => {
                const qty = parseInt(pQty);
                const name = pName.trim();
                if (!name) { alert('Enter product name.'); return; }
                if (!pMl) { alert('Select ML size.'); return; }
                if (!qty || qty <= 0) { alert('Enter a valid quantity.'); return; }
                const cost = parseFloat(pCost) || 0;
                const price = parseFloat(pPrice) || 0;
                const ml = Number(pMl);
                const existing = products.find(p => p.name.toLowerCase() === name.toLowerCase() && p.ml === ml);
                if (existing) {
                    setProducts(prev => prev.map(p => p.id === existing.id ? { ...p, stock: p.stock + qty, cost: cost || p.cost, price: price || p.price } : p));
                } else {
                    setProducts(prev => [...prev, { id: Date.now().toString(), name, ml, cost, price, stock: qty }]);
                }
                setPurchases(prev => [...prev, { id: Date.now(), date: new Date().toISOString(), productName: name, ml, qty, totalCost: qty * cost }]);
                setPName(''); setPMl(''); setPCost(''); setPPrice(''); setPQty('');
            };

            const names = [...new Set(products.map(p => p.name))];
            const sizesFor = (name) => products.filter(p => p.name === name).sort((a, b) => (a.ml || 0) - (b.ml || 0));
            const tabs = [['pos', 'Sales (POS)'], ['purchase', 'Purchase'], ['returns', 'Sales Return'], ['expenses', 'Expenses'], ['reports', 'Reports']];

            return (
                <div className="min-h-screen">
                    <header className="bg-card border-b border-gold p-4 flex flex-wrap gap-3 justify-between items-center no-print">
                        <div className="flex items-center gap-4">
                            {LOGO_SRC ? <img src={LOGO_SRC} alt="ZAHN" className="h-14 w-14 object-contain rounded" /> : <h2 className="text-2xl font-bold tracking-widest text-gold" style={{fontFamily: 'serif'}}>ZAHN</h2>}
                            <span className="text-xs tracking-widest opacity-70 border-l border-gold pl-4">POS SYSTEM</span>
                        </div>
                        <nav className="flex gap-2 flex-wrap">
                            {tabs.map(([key, label]) => (
                                <button key={key} onClick={() => setActiveTab(key)}
                                    className={`px-4 py-2 rounded font-semibold ${activeTab === key ? 'bg-gold text-black' : 'border border-gold text-gold hover:bg-gold hover:text-black'}`}>
                                    {label}
                                </button>
                            ))}
                        </nav>
                    </header>

                    <main className="p-6 no-print">
                        {activeTab === 'pos' && (
                            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div className="md:col-span-2">
                                    <h3 className="text-xl mb-4 font-bold text-gold border-b border-gold pb-2">Select Products</h3>
                                    {pickName && (
                                        <div className="bg-card border border-gold p-4 rounded mb-6">
                                            <div className="flex justify-between items-center mb-3">
                                                <h4 className="font-bold text-gold">Select ML for {pickName}</h4>
                                                <button onClick={() => setPickName(null)} className="text-sm border border-gold px-2 rounded">Cancel</button>
                                            </div>
                                            <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                                                {sizesFor(pickName).map(p => (
                                                    <button key={p.id} disabled={p.stock <= 0} onClick={() => { addToCart(p); setPickName(null); }}
                                                        className="border border-gold p-3 rounded text-left disabled:opacity-40 hover:bg-[#111f30]">
                                                        <p className="font-bold">{p.ml ? `${p.ml} ML` : 'No size'}</p>
                                                        <p className="text-sm opacity-70">Stock: {p.stock}</p>
                                                        <p className="text-gold font-bold">SAR {p.price}</p>
                                                    </button>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    <div className="grid grid-cols-2 lg:grid-cols-3 gap-4">
                                        {names.length === 0 ? <p className="text-gray-500">No products available. Add items in Purchase tab.</p> :
                                            names.map(name => {
                                                const total = sizesFor(name).reduce((s, p) => s + p.stock, 0);
                                                return (
                                                    <div key={name} onClick={() => setPickName(name)} className="bg-card border border-gold p-4 rounded cursor-pointer hover:bg-[#111f30] transition">
                                                        <h4 className="font-bold text-lg">{name}</h4>
                                                        <p className="text-sm opacity-70">Stock: {total} · {sizesFor(name).map(p => mlLabel(p.ml)).filter(Boolean).join(', ')}</p>
                                                    </div>
                                                );
                                            })}
                                    </div>
                                </div>
                                <div className="bg-card border border-gold p-4 rounded flex flex-col md:h-[80vh]">
                                    <h3 className="text-xl mb-4 font-bold text-gold border-b border-gold pb-2">Current Bill</h3>
                                    <div className="flex flex-col gap-2 mb-4">
                                        <input type="text" placeholder="Customer Name (Optional)" className="field" value={customerName} onChange={e => setCustomerName(e.target.value)} />
                                        <input type="text" placeholder="Phone Number (Optional)" className="field" value={customerPhone} onChange={e => setCustomerPhone(e.target.value)} />
                                    </div>
                                    <div className="flex-1 overflow-auto">
                                        {cart.map(item => (
                                            <div key={item.id} className="flex justify-between items-center mb-2 border-b border-gray-700 pb-2">
                                                <div>
                                                    <p className="font-bold">{itemLabel(item.name, item.ml)}</p>
                                                    <p className="text-sm opacity-70">{item.qty} x SAR {item.price}</p>
                                                </div>
                                                <div className="flex items-center gap-3">
                                                    <p className="font-bold">SAR {item.qty * item.price}</p>
                                                    <button onClick={() => removeFromCart(item.id)} className="text-red-400 text-sm border border-red-400 px-2 rounded">x</button>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                    <div className="mt-4 pt-4 border-t border-gold">
                                        <div className="flex gap-2 mb-3">
                                            <select className="field w-full" value={payment} onChange={e => setPayment(e.target.value)}>
                                                <option value="Cash">Cash</option>
                                                <option value="Card">Card</option>
                                            </select>
                                        </div>
                                        <div className="flex gap-2 mb-3">
                                            <select className="field" value={discountType} onChange={e => setDiscountType(e.target.value)}>
                                                <option value="amount">SAR</option>
                                                <option value="percent">%</option>
                                            </select>
                                            <input type="number" min="0" placeholder="Discount" className="field w-full" value={discount} onChange={e => setDiscount(e.target.value)} />
                                        </div>
                                        {discountAmt > 0 && <div className="flex justify-between text-sm mb-1"><span>Subtotal</span><span>SAR {subtotal}</span></div>}
                                        {discountAmt > 0 && <div className="flex justify-between text-sm mb-2 text-green-400"><span>Discount</span><span>- SAR {discountAmt}</span></div>}
                                        <div className="flex justify-between text-xl font-bold mb-4">
                                            <span>Total:</span>
                                            <span className="text-gold">SAR {cartTotal}</span>
                                        </div>
                                        <button onClick={completeSale} disabled={cart.length === 0} className="w-full bg-gold text-black font-bold py-3 rounded hover:opacity-90 disabled:opacity-50">
                                            COMPLETE SALE & PRINT
                                        </button>
                                        {waSale && waSale.customerPhone && (
                                            <a href={sendWhatsApp(waSale)} target="_blank" rel="noopener noreferrer" className="block text-center w-full mt-3 bg-green-600 text-white font-bold py-2 rounded hover:bg-green-700">
                                                SEND BILL ON WHATSAPP ({waSale.customerName})
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        )}

                        {activeTab === 'purchase' && (
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div className="bg-card border border-gold p-6 rounded">
                                    <h3 className="text-xl mb-4 font-bold text-gold border-b border-gold pb-2">Add Stock / New Purchase</h3>
                                    <details className="mb-4 border border-gold p-3 rounded" open>
                                        <summary className="font-bold text-gold cursor-pointer mb-3">Bulk Oil Purchase (Litre to Bottles)</summary>
                                        <div className="space-y-3">
                                            <input type="text" placeholder="Perfume Name" className="field w-full" value={bName} onChange={e => setBName(e.target.value)} />
                                            <div className="flex gap-3">
                                                <input type="number" placeholder="Total oil bought (ML)" className="field w-full" value={bMl} onChange={e => setBMl(e.target.value)} />
                                                <input type="number" placeholder="Total cost (SAR)" className="field w-full" value={bCost} onChange={e => setBCost(e.target.value)} />
                                            </div>
                                            <p className="text-sm opacity-80">
                                                Cost per ML: SAR {(parseFloat(bMl) > 0 && parseFloat(bCost) > 0) ? (parseFloat(bCost) / parseFloat(bMl)).toFixed(3) : '0'}
                                                {' · '}Used: {ML_SIZES.reduce((s, m) => s + m * (parseInt(bCounts[m]) || 0), 0)} ML
                                                {' · '}Left: {(parseFloat(bMl) || 0) - ML_SIZES.reduce((s, m) => s + m * (parseInt(bCounts[m]) || 0), 0)} ML
                                            </p>
                                            {ML_SIZES.map(ml => (
                                                <div key={ml} className="flex gap-2 items-center">
                                                    <span className="w-16 text-sm">{ml} ML</span>
                                                    <input type="number" placeholder="Bottles" className="field w-full" value={bCounts[ml] || ''} onChange={e => setBCounts({ ...bCounts, [ml]: e.target.value })} />
                                                    <input type="number" placeholder="Sell price" className="field w-full" value={bPrices[ml] || ''} onChange={e => setBPrices({ ...bPrices, [ml]: e.target.value })} />
                                                </div>
                                            ))}
                                            <button onClick={addBulk} className="w-full bg-gold text-black font-bold py-2 rounded">ADD BULK PURCHASE</button>
                                        </div>
                                    </details>
                                    <div className="space-y-4">
                                        <input type="text" list="zahn-names" placeholder="Perfume Name" className="field w-full" value={pName} onChange={e => setPName(e.target.value)} />
                                        <datalist id="zahn-names">{names.map(n => <option key={n} value={n} />)}</datalist>
                                        <select className="field w-full" value={pMl} onChange={e => setPMl(e.target.value)}>
                                            <option value="">-- Select ML --</option>
                                            {ML_SIZES.map(m => <option key={m} value={m}>{m} ML</option>)}
                                        </select>
                                        <div className="flex flex-col sm:flex-row gap-4">
                                            <input type="number" placeholder="Cost Price (SAR)" className="field w-full" value={pCost} onChange={e => setPCost(e.target.value)} />
                                            <input type="number" placeholder="Selling Price (SAR)" className="field w-full" value={pPrice} onChange={e => setPPrice(e.target.value)} />
                                        </div>
                                        <input type="number" placeholder="Quantity Purchased" className="field w-full" value={pQty} onChange={e => setPQty(e.target.value)} />
                                        <button onClick={addPurchase} className="w-full bg-gold text-black font-bold py-2 rounded">UPDATE STOCK</button>
                                    </div>
                                </div>
                                <div className="bg-card border border-gold p-6 rounded">
                                    <h3 className="text-xl mb-4 font-bold text-gold border-b border-gold pb-2">Purchase History</h3>
                                    <div className="overflow-auto h-[60vh]">
                                        {purchases.slice().reverse().map(p => (
                                            <div key={p.id} className="border-b border-gray-700 py-2 flex justify-between">
                                                <div>
                                                    <p className="font-bold">{itemLabel(p.productName, p.ml)}</p>
                                                    <p className="text-sm opacity-70">{new Date(p.date).toLocaleDateString()}</p>
                                                </div>
                                                <div className="text-right">
                                                    <p>Qty: {p.qty}</p>
                                                    <p className="text-gold font-bold">Total: SAR {p.totalCost}</p>
                                                    <button onClick={() => startEdit(p)} className="text-sm border border-gold px-2 rounded mt-1">Edit</button>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        )}

                        {activeTab === 'returns' && <ReturnsView products={products} setProducts={setProducts} returns={returns} setReturns={setReturns} />}
                        {activeTab === 'expenses' && <ExpensesView expenses={expenses} setExpenses={setExpenses} />}
                        {activeTab === 'reports' && <ReportsView sales={sales} returns={returns} purchases={purchases} products={products} expenses={expenses} />}
                    </main>

                    {editPurchase && (
                        <div className="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center p-4 no-print z-50">
                            <div className="bg-card border border-gold p-6 rounded w-full max-w-sm space-y-4">
                                <h3 className="text-lg font-bold text-gold">Edit: {itemLabel(editPurchase.name, editPurchase.ml)}</h3>
                                <label className="block text-sm opacity-80">Quantity</label>
                                <input type="number" className="field w-full" value={editPurchase.qty} onChange={e => setEditPurchase({ ...editPurchase, qty: e.target.value })} />
                                <label className="block text-sm opacity-80">Unit cost (SAR)</label>
                                <input type="number" className="field w-full" value={editPurchase.unitCost} onChange={e => setEditPurchase({ ...editPurchase, unitCost: e.target.value })} />
                                <div className="flex gap-2">
                                    <button onClick={saveEdit} className="flex-1 bg-gold text-black font-bold py-2 rounded">Save</button>
                                    <button onClick={() => setEditPurchase(null)} className="flex-1 border border-gold py-2 rounded">Cancel</button>
                                </div>
                                <button onClick={deletePurchase} className="w-full border border-red-400 text-red-400 py-2 rounded">Delete this purchase</button>
                            </div>
                        </div>
                    )}

                    {billToPrint && (
                        <div className="print-only p-8 bg-white text-black min-h-screen">
                            <Logo />
                            <div className="text-center mb-6">
                                <h2 className="text-xl font-bold">TAX INVOICE</h2>
                                <p className="text-sm">Riyadh, Saudi Arabia</p>
                                <p className="text-sm">Date: {new Date(billToPrint.date).toLocaleString()}</p>
                            </div>
                            <div className="mb-6">
                                <p><strong>Customer:</strong> {billToPrint.customerName}</p>
                                {billToPrint.customerPhone && <p><strong>Phone:</strong> {billToPrint.customerPhone}</p>}
                                <p><strong>Invoice No:</strong> #{billToPrint.id}</p>
                                <p><strong>Payment:</strong> {billToPrint.payment || 'Cash'}</p>
                            </div>
                            <table className="w-full text-left mb-6 border-collapse">
                                <thead>
                                    <tr className="border-b-2 border-black">
                                        <th className="py-2">Item Description</th>
                                        <th>Qty</th>
                                        <th>Price (SAR)</th>
                                        <th className="text-right">Total (SAR)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {billToPrint.items.map((item, idx) => (
                                        <tr key={idx} className="border-b border-gray-300">
                                            <td className="py-2">{itemLabel(item.name, item.ml)}</td>
                                            <td>{item.qty}</td>
                                            <td>{item.price}</td>
                                            <td className="text-right">{item.qty * item.price}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                            <div className="flex justify-end">
                                <div className="w-1/2">
                                    {billToPrint.discount > 0 && <div className="flex justify-between mb-1"><span>Subtotal:</span><span>SAR {billToPrint.subtotal}</span></div>}
                                    {billToPrint.discount > 0 && <div className="flex justify-between mb-2"><span>Discount:</span><span>- SAR {billToPrint.discount}</span></div>}
                                    <div className="flex justify-between font-bold text-xl border-t-2 border-black pt-2">
                                        <span>Grand Total:</span>
                                        <span>SAR {billToPrint.totalAmount}</span>
                                    </div>
                                </div>
                            </div>
                            <div className="mt-16 text-center text-sm">
                                <p>Thank you for shopping with ZAHN!</p>
                                <p>Essence of You.</p>
                            </div>
                        </div>
                    )}
                </div>
            );
        };

        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>
